#include <SPI.h>
#include <Ethernet.h>

byte mac[] = { 0xDE, 0xAD, 0xBE, 0xEF, 0xFE, 0xED };
IPAddress ip(192, 168, 1, 50);       // Teensy IP
IPAddress redisIP(192, 168, 1, 100); // Redis server IP

EthernetClient client;

void setup() {
  Serial.begin(115200);
  Ethernet.begin(mac, ip);

  Serial.println("Connecting to Redis...");
  if (client.connect(redisIP, 6379)) {
    Serial.println("Connected to Redis!");
    // Redis uses RESP protocol. To set a key: "*3\r\n$3\r\nSET\r\n$3\r\nfoo\r\n$3\r\nbar\r\n"
    client.print("*3\r\n$3\r\nSET\r\n$3\r\nfoo\r\n$3\r\nbar\r\n");
  } else {
    Serial.println("Redis connection failed.");
  }
}

void loop() {
  while (client.available()) {
    char c = client.read();
    Serial.print(c); // Print Redis response, e.g. "+OK"
  }
}
